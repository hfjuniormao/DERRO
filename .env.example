# CENTRAL INFRA RO 360 — variaveis de ambiente (copie para .env.local)
# NUNCA commite segredos: .env.local esta no .gitignore.

# Chave da API ArcGIS (opcional em desenvolvimento; recomendada em producao).
# ArcGIS Maps SDK for JavaScript — developers.arcgis.com
VITE_ARCGIS_API_KEY=

# Portal ArcGIS Enterprise usado no fluxo OAuth 2.0 (Authorization Code + PKCE).
# Exemplo: https://states.arcgis.com -> VITE_ARCGIS_PORTAL_ID=states
VITE_ARCGIS_PORTAL_ID=

# Client ID do aplicativo ArcGIS (publico). O client_secret fica NO BACKEND.
VITE_ARCGIS_CLIENT_ID=

# URL do backend de producao (FastAPI). Vazio = modo demonstracao.
VITE_API_BASE_URL=

# Modo de operacao dos dados: demonstracao | producao
VITE_MODO_DADOS=demonstracao

# Registra o service worker (PWA). false desativa.
VITE_PWA_ATIVO=true
